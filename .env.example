APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-* (Docker + Cloudflare ranges behind Traefik). Empty = none.
TRUSTED_PROXIES=

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=
# true: System Ops backups/restores connect without TLS (Docker MariaDB client vs MySQL's self-signed cert)
DB_DUMP_SKIP_SSL=false

# Off-site copy of each System Ops backup on Google Drive (docs/GOOGLE_DRIVE_BACKUPS.md)
BACKUP_ARCHIVE_PASSWORD=
BACKUP_GOOGLE_DRIVE_ENABLED=false
BACKUP_GOOGLE_DRIVE_KEEP_DAYS=14
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Folder path inside My Drive, created if missing (e.g. "Spot Backups/Accounts"); not a folder ID
GOOGLE_DRIVE_FOLDER=
# Optional Shared Drive ID (folder is then relative to that drive)
GOOGLE_DRIVE_TEAM_DRIVE_ID=

BROADCAST_DRIVER=log
CACHE_STORE=file
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
# true: scheduler runs `queue:work --stop-when-empty` each minute (cron-only hosting). false when a queue:work container runs.
QUEUE_WORKER_VIA_SCHEDULER=true
SESSION_DRIVER=file

# WooCommerce inventory webhook (config/services.php → wordpress_webhook)
WORDPRESS_WEBHOOK_URL=
WORDPRESS_WEBHOOK_SECRET=
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# System Ops page (admin + this password)
SYSTEM_OPS_PASSWORD=

# POS catalog sync: one POS product per game offer / card category (README_API.md)
# Set false to stop pushing; sales then use the shared POS product ids from Settings.
POS_CATALOG_SYNC=true
POS_BUSINESS_ID=1
POS_CATALOG_SYNC_TIMEOUT=20
# pos:sync-catalog waits out POS rate limits (429) up to this many times per request, max seconds per wait
POS_CATALOG_SYNC_MAX_RETRIES=5
POS_CATALOG_SYNC_MAX_RETRY_WAIT=60
